// Configuration Cloudflare du site de vente ROSELLE.
// Cloudflare relit ce fichier à chaque modification du dépôt GitHub et
// redéploie automatiquement le Worker "rosellestore".
// Le nom DOIT rester "rosellestore" : c'est celui du Worker dans le tableau de bord Cloudflare.
{
  "name": "rosellestore",
  "compatibility_date": "2026-10-09",
  // V2.24 : petit programme qui enregistre les commandes (src/worker.js).
  // V6.3 : il sert aussi les photos (/img/...) depuis la mémoire de Cloudflare,
  // ce qui compte dans les requêtes du Worker (offre payante 5 $ : 10 millions/mois).
  // Il ne tourne QUE pour les adresses /api/... ; tout le reste du site
  // (pages, images, vidéo) reste servi directement, sans compter dans
  // les 100 000 requêtes gratuites par jour.
  "main": "src/worker.js",
  // Site statique : tous les fichiers du dossier public/ sont servis tels quels
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/*"]
  },
  // V2.29 : limites anti-robots sur les commandes (gratuites, comptées par
  // lieu Cloudflare). "period" vaut 10 ou 60 secondes uniquement.
  // - par connexion : 60 commandes par minute (V6.8, avant 20 : beaucoup de
  //   clientes partagent la même adresse chez un opérateur mobile) ;
  // - par numéro de téléphone : 1 commande par minute (V6.8, avant 3).
  "ratelimits": [
    { "name": "LIMITE_COMMANDES", "namespace_id": "2901", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIMITE_TELEPHONE", "namespace_id": "2902", "simple": { "limit": 1, "period": 60 } },
    // V5.7 : statistiques de visite, 300 événements par minute et par connexion
    // (large : beaucoup de clientes partagent la même adresse chez l'opérateur).
    { "name": "LIMITE_STATS", "namespace_id": "2903", "simple": { "limit": 300, "period": 60 } }
  ]
  // Clés secrètes FIREBASE_SA, TURNSTILE_SECRET et TURNSTILE_SITE_KEY : ajoutées
  // à la main dans Cloudflare (Workers > rosellestore > Paramètres > Variables
  // et secrets), jamais ici.
}
